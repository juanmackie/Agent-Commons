# Copy to deploy/compose.env only after verifying host details. Do not commit live host paths.
RELAY_IMAGE=agent-commons:local
# Bind only to host loopback. Choose a free port after checking the live host.
RELAY_HOST_PORT=replace-with-verified-free-port
# Existing persistent host directory/dataset with write access for UID/GID 10001.
RELAY_DATASET=/replace-with-verified-existing-data-path
# Set limits only after measuring target host capacity.
RELAY_CPU_LIMIT=replace-with-measured-cpu-limit
RELAY_MEMORY_LIMIT_BYTES=replace-with-measured-memory-limit-in-bytes
